___TESTS___

scenarios:
- name: Loads the workspace's script with Adway Apply and queues granted consent
  code: |-
    const workspaceId = '1b2cbe93-90ee-4e80-be13-320b1d54f1e9';
    let injected;
    let queued = [];
    mock('injectScript', (url, onSuccess) => { injected = url; onSuccess(); });
    mock('isConsentGranted', (type) => true);
    mock('copyFromWindow', (key) => undefined);
    mock('createQueue', (key) => { assertThat(key).isEqualTo('Adway.q'); return (value) => queued.push(value); });

    runCode({ workspaceId: workspaceId, apply: 'banner', consentSource: 'consentMode', environment: 'beta' });

    assertThat(injected).isEqualTo('https://uaajzckpdopfifluopgi.supabase.co/functions/v1/tracking-script?wid=' + workspaceId + '&apply=banner');
    assertThat(queued).isEqualTo([['consent', { marketing: true }]]);
    assertApi('gtmOnSuccess').wasCalled();
- name: Denied ad user data keeps tracking off until the visitor's later yes
  code: |-
    let adUserData = false;
    let calls = [];
    let listeners = {};
    let injected;
    mock('injectScript', (url, onSuccess) => { injected = url; onSuccess(); });
    mock('isConsentGranted', (type) => type === 'ad_storage' || adUserData);
    mock('copyFromWindow', (key) => key === 'Adway.consent' ? (() => true) : undefined);
    mock('callInWindow', (key, choice) => { calls.push([key, choice]); });
    mock('addConsentListener', (type, listener) => { listeners[type] = listener; });

    runCode({ workspaceId: '1b2cbe93-90ee-4e80-be13-320b1d54f1e9', apply: 'off', consentSource: 'consentMode', environment: 'production' });
    assertThat(calls).isEqualTo([['Adway.consent', { marketing: false }]]);

    adUserData = true;
    listeners.ad_user_data();
    assertThat(calls[1]).isEqualTo(['Adway.consent', { marketing: true }]);
    // Production, and no Apply when it is switched off.
    assertThat(injected).isEqualTo('https://wwfmahhghaizutxzsmbq.supabase.co/functions/v1/tracking-script?wid=1b2cbe93-90ee-4e80-be13-320b1d54f1e9');
- name: The site's own consent source leaves consent to IAB TCF or Adway.consent
  code: |-
    mock('injectScript', (url, onSuccess) => onSuccess());
    runCode({ workspaceId: '1b2cbe93-90ee-4e80-be13-320b1d54f1e9', apply: 'buttons', consentSource: 'site', environment: 'production' });
    assertApi('isConsentGranted').wasNotCalled();
    assertApi('addConsentListener').wasNotCalled();
    assertApi('gtmOnSuccess').wasCalled();
- name: A script that fails to load reports failure
  code: |-
    mock('injectScript', (url, onSuccess, onFailure) => onFailure());
    mock('isConsentGranted', (type) => false);
    mock('copyFromWindow', (key) => undefined);
    mock('createQueue', (key) => (value) => value);
    runCode({ workspaceId: '1b2cbe93-90ee-4e80-be13-320b1d54f1e9', apply: 'banner', consentSource: 'consentMode', environment: 'production' });
    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();


___NOTES___

Adway tag template. The script it loads is Adway's tracking snippet: with an
apply setting it brings Adway Apply onto the page at once, and it keeps the
Meta pixel and the visit beacon off until marketing consent arrives.
