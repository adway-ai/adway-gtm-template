___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const encodeUriComponent = require('encodeUriComponent');
const isConsentGranted = require('isConsentGranted');
const addConsentListener = require('addConsentListener');
const copyFromWindow = require('copyFromWindow');
const callInWindow = require('callInWindow');
const createQueue = require('createQueue');
const setInWindow = require('setInWindow');

const SCRIPT = {
  production: 'https://wwfmahhghaizutxzsmbq.supabase.co/functions/v1/tracking-script',
  beta: 'https://uaajzckpdopfifluopgi.supabase.co/functions/v1/tracking-script'
};

let src = (SCRIPT[data.environment] || SCRIPT.production) + '?wid=' + encodeUriComponent(data.workspaceId);
if (data.apply === 'banner' || data.apply === 'buttons') {
  src = src + '&apply=' + data.apply;
}

// Marketing consent in Google Consent Mode terms: ad storage and ad user data.
const marketingGranted = () => isConsentGranted('ad_storage') && isConsentGranted('ad_user_data');

// Hands the visitor's choice to the Adway script; before it has loaded, the
// choice waits in window.Adway.q, which the script reads when it starts.
const tellAdway = () => {
  const choice = { marketing: marketingGranted() };
  if (copyFromWindow('Adway.consent')) {
    callInWindow('Adway.consent', choice);
  } else {
    setInWindow('Adway', {}, false);
    createQueue('Adway.q')(['consent', choice]);
  }
};

if (data.consentSource !== 'site') {
  tellAdway();
  addConsentListener('ad_storage', tellAdway);
  addConsentListener('ad_user_data', tellAdway);
}

injectScript(src, data.gtmOnSuccess, data.gtmOnFailure, src);


